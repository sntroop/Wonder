<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон приложения: чёрный с очень мягкой белой дымкой сверху.
  Никаких oval/обводок: только линейный градиент и радиальное пятно,
  которое ПОЛНОСТЬЮ растворяется в прозрачность ДО краёв экрана,
  поэтому границ и колец не видно.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#0A0A0A"
                android:centerColor="#050505"
                android:endColor="#000000"
                android:centerY="0.30" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="560dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="340dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#1FFFFFFF"
                android:centerColor="#0DD9D9D9"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
