<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- выбранный чипс: белая плашка (текст у него чёрный).
         Раньше фон был прозрачный и всё держалось на LiquidBlob - если капля
         не успевала встать, текст активной вкладки становился невидимым. -->
