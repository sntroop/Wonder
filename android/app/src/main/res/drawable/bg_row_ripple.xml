<?xml version="1.0" encoding="utf-8"?>
<!-- Строка списка: та же плашка, но с аккуратным скруглённым откликом
     на нажатие. Раньше ripple был прямоугольным и брал цвет акцента
     прошивки - отсюда «жёлтый квадрат» при тапе. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FFFFFFF">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#08FFFFFF" />
            <stroke android:width="1dp" android:color="#0BFFFFFF" />
        </shape>
    </item>
</ripple>
