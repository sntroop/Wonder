<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/upload_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Новый трек"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/upload_cooldown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B9B9B9"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <!-- аудио -->
            <TextView
                style="@style/SettingsSectionText"
                android:text="АУДИО" />

            <LinearLayout
                android:id="@+id/upload_pick"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#C9C9C9" />

                <TextView
                    android:id="@+id/upload_audio_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="Выбрать файл"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <!-- обложка -->
            <TextView
                style="@style/SettingsSectionText"
                android:text="ОБЛОЖКА" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/upload_pick_cover"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_cover"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/upload_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_plus"
                        android:tint="#A9A9A9"
                        android:padding="28dp"
                        android:contentDescription="Обложка" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Квадратная картинка\nJPG или PNG"
                    android:textColor="#8A8A8A"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- название -->
            <TextView
                style="@style/SettingsSectionText"
                android:text="НАЗВАНИЕ" />

            <EditText
                android:id="@+id/upload_title"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Как называется трек"
                android:inputType="text"
                android:maxLength="120"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="15sp"
                android:autofillHints="" />

            <!-- жанр -->
            <TextView
                style="@style/SettingsSectionText"
                android:text="ЖАНР" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/upload_genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- дроп для шортсов -->
            <TextView
                style="@style/SettingsSectionText"
                android:text="ДРОП ДЛЯ ШОРТСОВ" />

            <TextView
                android:id="@+id/upload_drop_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Выбери момент, который попадёт в шортсы"
                android:textColor="#B9B9B9"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/upload_drop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="1"
                android:progress="0" />

            <TextView
                android:id="@+id/upload_len_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Длина куска: 15 сек"
                android:textColor="#8A8A8A"
                android:textSize="12.5sp" />

            <SeekBar
                android:id="@+id/upload_len"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="22"
                android:progress="7" />

            <TextView
                android:id="@+id/upload_go"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Опубликовать"
                android:textColor="#0A0A0A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn" />

            <TextView
                android:id="@+id/upload_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Один трек в 24 часа"
                android:textColor="#6E6E6E"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
