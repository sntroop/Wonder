<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Новый плейлист"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/np_cover"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_cover_big"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:contentDescription="Обложка плейлиста" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/np_title"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_field"
                android:hint="Название"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#F2F2F2"
                android:textColorHint="#767676"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/np_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="top"
                android:hint="Описание"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="52dp"
                android:maxLines="3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#F2F2F2"
                android:textColorHint="#767676"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/np_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="1 трек"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/np_tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/np_create"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn"
        android:gravity="center"
        android:text="Создать"
        android:textColor="#0A0A0A"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
