<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingEnd="62dp"
        android:paddingTop="72dp"
        android:paddingBottom="110dp">

        <!-- прозрачный кружок вокруг обложки (вокруг него бьёт эквалайзер) -->
        <FrameLayout
            android:id="@+id/short_orb"
            android:layout_width="232dp"
            android:layout_height="232dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:id="@+id/short_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="9dp"
                android:background="@drawable/bg_cover_big"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:contentDescription="Обложка" />

            <!-- Тап по обложке = пауза/продолжить (как в TikTok).
                 Кружок виден, когда трек на паузе. -->
            <ImageView
                android:id="@+id/short_pp"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_circle"
                android:padding="16dp"
                android:src="@drawable/ic_play"
                android:tint="@color/text_primary"
                android:visibility="gone"
                android:contentDescription="Играть" />
        </FrameLayout>

        <TextView
            android:id="@+id/short_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/short_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/short_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Слушать целиком"
                android:textColor="#0A0A0A"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/short_add"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/short_add_ic"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/text_primary"
                    android:contentDescription="Добавить к себе" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/short_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#EDEDED"
            android:textSize="12sp"
            android:visibility="gone" />

        <su.gwarden.music.ui.ClipProgress
            android:id="@+id/short_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="листай вверх — следующий"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/short_like"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_glass_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/short_like_ic"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart_outline"
                android:tint="#F2F2F2"
                android:contentDescription="Лайк" />
        </FrameLayout>

        <TextView
            android:id="@+id/short_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />

        <FrameLayout
            android:id="@+id/short_dislike"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/short_dislike_ic"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dislike"
                android:tint="#F2F2F2"
                android:contentDescription="Не нравится" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/short_cmt"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/short_cmt_ic"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_comment"
                android:tint="#F2F2F2"
                android:contentDescription="Комментарии" />
        </FrameLayout>

        <TextView
            android:id="@+id/short_cmt_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

</FrameLayout>
