<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_row"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:id="@+id/item_art_box"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/item_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:contentDescription="Обложка" />

        <View
            android:id="@+id/item_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scrim_sm"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/item_down"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:src="@drawable/ic_downloaded"
            android:tint="#FFFFFF"
            android:visibility="gone"
            android:contentDescription="Скачано" />

        <su.gwarden.music.ui.EqBars
            android:id="@+id/item_eq"
            android:layout_width="20dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/item_add"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="2dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_plus"
        android:tint="#BEBEBE"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Добавить в мою музыку"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/item_more"
        android:layout_width="30dp"
        android:layout_height="32dp"
        android:layout_marginStart="1dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dots"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ещё" />

    <TextView
        android:id="@+id/item_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:fontFamily="sans-serif" />
</LinearLayout>
