<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicPlayer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- брутальный шрифт во всём приложении (Unbounded, есть кириллица) -->
        <item name="android:fontFamily">@font/unbounded_family</item>
        <item name="fontFamily">@font/unbounded_family</item>
        <!-- Свои цвета "нажатия": без них система подставляет акцент прошивки,
             и по кнопкам пробегает жёлтый/цветной квадрат. -->
        <item name="android:colorControlHighlight">#1FFFFFFF</item>
        <item name="colorControlHighlight">#1FFFFFFF</item>
        <item name="android:textViewStyle">@style/WonderText</item>
        <item name="android:editTextStyle">@style/WonderEdit</item>
    </style>

    <style name="WonderText" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/unbounded_family</item>
    </style>

    <style name="WonderEdit" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/unbounded_family</item>
    </style>

    <!-- Шторки и диалоги: раньше они открывались с СИСТЕМНОЙ темой, из-за
         чего внутри был чужой шрифт и цветной (жёлтый) ripple прошивки.
         Теперь всё наследует нашу монохромную тему. -->
    <style name="Theme.Wonder.Sheet" parent="Theme.MusicPlayer">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.Wonder.Fullscreen" parent="Theme.Wonder.Sheet">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ── Сменные шрифты ────────────────────────────────────────────────
         Выбор шрифта накладывает один из этих overlay-стилей на тему
         Activity (Skin.applyTheme) ДО создания вьюх. Отдельные textViewStyle
         нужны потому, что базовый WonderText жёстко задаёт Unbounded. -->

    <style name="Font.Overlay.Manrope" parent="">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:textViewStyle">@style/Text.Manrope</item>
        <item name="android:editTextStyle">@style/Edit.Manrope</item>
    </style>

    <style name="Text.Manrope" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/manrope</item>
    </style>

    <style name="Edit.Manrope" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/manrope</item>
    </style>

    <style name="Font.Overlay.Inter" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textViewStyle">@style/Text.Inter</item>
        <item name="android:editTextStyle">@style/Edit.Inter</item>
    </style>

    <style name="Text.Inter" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Edit.Inter" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Font.Overlay.Jetbrains" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textViewStyle">@style/Text.Jetbrains</item>
        <item name="android:editTextStyle">@style/Edit.Jetbrains</item>
    </style>

    <style name="Text.Jetbrains" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>

    <style name="Edit.Jetbrains" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>

    <style name="Font.Overlay.PtSerif" parent="">
        <item name="android:fontFamily">@font/pt_serif</item>
        <item name="fontFamily">@font/pt_serif</item>
        <item name="android:textViewStyle">@style/Text.PtSerif</item>
        <item name="android:editTextStyle">@style/Edit.PtSerif</item>
    </style>

    <style name="Text.PtSerif" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/pt_serif</item>
    </style>

    <style name="Edit.PtSerif" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/pt_serif</item>
    </style>
</resources>
